FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
TENANT=demo

# App database (users, teams, projects, chats). Neon in production; the local default is the compose container.
DATABASE_URL=postgresql+psycopg://warden:warden@localhost:5433/warden
SESSION_SECRET=change-me-to-a-long-random-string
# Cross-site cookie when the UI is on another domain (Vercel): COOKIE_SAMESITE=none and COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Demo org source (read-only). Ingestion clones this repo at DEMO_REF.
DEMO_REPO_URL=https://github.com/GoogleCloudPlatform/microservices-demo.git
DEMO_REF=v0.8.0
# Commit history window for PRs / expertise
HISTORY_SINCE=2022-06-15

# Agent LLM (any OpenAI-compatible endpoint). Groq is fast, which matters for the live demo.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# OpenRouter instead: LLM_BASE_URL=https://openrouter.ai/api/v1 and an OpenRouter model id

# GitHub actions (Phase 2). Writes are only ever allowed on GITHUB_OWNER/GITHUB_REPO.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=microservices-demo
# Fork branch at DEMO_REF that Warden's PRs target
GITHUB_BASE=demo-base
