# Copy to .env. Never commit .env.

# --- FalkorDB (compose sets host/port for you on EC2; use these for FalkorDB Cloud or a local container) ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
TENANT=demo

# --- The repository Warden reads (history, manifests, lockfiles) and its pinned release ---
DEMO_REPO_URL=https://github.com/GoogleCloudPlatform/microservices-demo.git
DEMO_REF=v0.8.0
HISTORY_SINCE=2022-06-15

# --- The fork Warden acts on: PRs, issues and comments go here, never upstream ---
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=microservices-demo
GITHUB_BASE=demo-base

# --- Agent LLM (any OpenAI-compatible endpoint) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# --- App data (users, teams, chats). Neon in production ---
DATABASE_URL=postgresql+psycopg://warden:warden@localhost:5433/warden
POSTGRES_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string

# --- Deploy: API on EC2, UI on Vercel ---
API_DOMAIN=api.example.com
CORS_ORIGINS=https://your-app.vercel.app
WARDEN_URL=https://your-app.vercel.app
COOKIE_SAMESITE=none
COOKIE_SECURE=true
